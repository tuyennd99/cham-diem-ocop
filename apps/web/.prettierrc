{
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "jsxSingleQuote": true,
  "plugins": [
    "@ianvs/prettier-plugin-sort-imports",
    "prettier-plugin-tailwindcss"
  ],
  "importOrder": [
    "^(react/(.*)$)|^(react$)",
    "<THIRD_PARTY_MODULES>",
    "^types$",
    "^@/types/(.*)$",
    "^@/constants/(.*)$",
    "^@/config/(.*)$",
    "^@/lib/(.*)$",
    "^@/providers/(.*)$",
    "^@/hooks/(.*)$",
    "^@/context/(.*)$",
    "^@/components/(.*)$",
    "^@/assets/(.*)$",
    "^@/locales/(.*)$",
    "^@/views/(.*)$",
    "^[./]"
  ]
}