PORT=3030
DATABASE_URL=postgresql://ocop_app:change-me@127.0.0.1:5432/ocop?schema=public
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-bytes
TRUST_PROXY_HOPS=1
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=OCOP <noreply@example.com>
STORAGE_PATH=./storage
# Optional first-run admin bootstrap. Set both before seeding, then remove them.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
