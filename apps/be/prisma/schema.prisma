generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REGISTRANT
  JUDGE
  ADMIN
  VIEWER
}

enum StaffPermission {
  MANAGE
  VIEW
  SCORE
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
}

enum PendingAuthKind {
  EMAIL_REGISTER
  GOOGLE_PROFILE
  GOOGLE_REGISTER
  GOOGLE_LINK
  GOOGLE_CHALLENGE
}

enum ProductStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  SCORING
  COMPLETED
}

enum AttachmentType {
  IMAGE
  EVIDENCE
}

enum EvaluationStatus {
  IN_PROGRESS
  SUBMITTED
  EXCLUDED
}

enum ProductPublicationState {
  UNPUBLISHED
  PUBLISHED
  UPDATING
}

model User {
  id                     String                    @id @default(cuid())
  email                  String                    @unique @db.VarChar(320)
  password               String?                   @db.VarChar(255)
  googleSub              String?                   @unique @db.VarChar(255)
  fullName               String                    @db.VarChar(255)
  phone                  String?                   @db.VarChar(30)
  role                   Role                      @default(REGISTRANT)
  roles                  Role[]                    @default([REGISTRANT])
  staffPermissions       StaffPermission[]         @default([])
  organizationUnitId     String?
  organizationUnit       OrganizationUnit?         @relation(fields: [organizationUnitId], references: [id], onDelete: Restrict)
  createdProducts        Product[]                 @relation("ProductCreator")
  approvedProducts       Product[]                 @relation("ProductApprover")
  returnedProducts       Product[]                 @relation("ProductReturner")
  publishedProducts      Product[]                 @relation("ProductPublisher")
  statusEvents           ProductStatusEvent[]      @relation("StatusEventActor")
  productAssignments     ProductJudgeAssignment[]  @relation("ProductJudge")
  assignedProducts       ProductJudgeAssignment[]  @relation("ProductAssignmentActor")
  removedAssignments     ProductJudgeAssignment[]  @relation("ProductAssignmentRemover")
  evaluationHistoryActed EvaluationHistoryEvent[]  @relation("EvaluationHistoryActor")
  resultHistoryActed     ProductResultHistory[]    @relation("ProductResultHistoryActor")
  verified               Boolean                   @default(false)
  isActive               Boolean                   @default(true)
  tokenVersion           Int                       @default(0)
  createdAt              DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                  @updatedAt @db.Timestamptz(3)
  products               Product[]                 @relation("ProductRegistrant")
  registrationUnits      RegistrationUnit[]        @relation("UserRegistrationUnits")
  assignments            JudgeAssignment[]
  evaluations            Evaluation[]
  otpCodes               OtpCode[]
  auditLogs              AuditLog[]                @relation("AuditActor")

  @@index([role])
  @@map("users")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(100)
  beforeData Json?
  afterData  Json?
  reason     String?  @db.VarChar(255)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(500)
  requestId  String?  @db.VarChar(100)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}

model OtpCode {
  id        String     @id @default(cuid())
  email     String     @db.VarChar(320)
  code      String     @db.VarChar(255)
  purpose   OtpPurpose
  expiresAt DateTime   @db.Timestamptz(3)
  usedAt    DateTime?  @db.Timestamptz(3)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, expiresAt])
  @@index([email, purpose, createdAt(sort: Desc)])
  @@index([expiresAt])
  @@index([userId])
  @@map("otp_codes")
}

model PendingAuth {
  id                String          @id @default(cuid())
  kind              PendingAuthKind
  tokenHash         String          @unique @db.VarChar(64)
  email             String?         @db.VarChar(320)
  fullName          String?         @db.VarChar(255)
  phone             String?         @db.VarChar(30)
  passwordHash      String?         @db.VarChar(255)
  googleSub         String?         @db.VarChar(255)
  nonceHash         String?         @db.VarChar(64)
  userId            String?
  otpHash           String?         @db.VarChar(64)
  attempts          Int             @default(0)
  expiresAt         DateTime        @db.Timestamptz(3)
  otpExpiresAt      DateTime?       @db.Timestamptz(3)
  resendAvailableAt DateTime?       @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("pending_auth")
}

model ManagingAgency {
  id                 String                      @id @default(cuid())
  code               String                      @unique @db.VarChar(50)
  name               String                      @unique @db.VarChar(255)
  order              Int                         @default(0)
  isActive           Boolean                     @default(true)
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(3)
  organizationUnits  OrganizationUnit[]
  categoryLinks      ProductCategoryAgency[]
  productAssignments ProductJudgeAssignment[]

  @@map("managing_agencies")
}

model ProductCategoryAgency {
  categoryId String
  agencyId   String
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  agency     ManagingAgency  @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@id([categoryId, agencyId])
  @@index([agencyId])
  @@map("product_category_agencies")
}

model OrganizationUnit {
  id               String          @id @default(cuid())
  code             String          @unique @db.VarChar(50)
  name             String          @db.VarChar(255)
  description      String?
  order            Int             @default(0)
  isActive         Boolean         @default(true)
  managingAgencyId String?
  managingAgency   ManagingAgency? @relation(fields: [managingAgencyId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(3)
  users            User[]

  @@index([managingAgencyId])
  @@map("organization_units")
}

model Locality {
  id               String    @id @default(cuid())
  code             String    @unique @db.VarChar(50)
  eventName        String    @default("") @db.VarChar(255)
  name             String    @db.VarChar(255)
  provinceName     String    @db.VarChar(255)
  effectiveFrom    DateTime? @db.Timestamptz(3)
  effectiveTo      DateTime? @db.Timestamptz(3)
  registrationFrom DateTime? @db.Timestamptz(3)
  registrationTo   DateTime? @db.Timestamptz(3)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  products         Product[]

  @@map("localities")
}

model ProductCategory {
  id          String                  @id @default(cuid())
  isActive    Boolean                 @default(true)
  order       Int                     @default(0)
  name        String                  @unique @db.VarChar(255)
  description String?
  createdAt   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                @updatedAt @db.Timestamptz(3)
  criteriaSet CriteriaSet?
  products    Product[]
  assignments JudgeAssignment[]
  agencyLinks ProductCategoryAgency[]

  @@map("product_categories")
}

model LegacyCategoryMetadata {
  id   String @id
  data Json

  @@map("legacy_category_metadata")
}

model LegacyProductGroupMetadata {
  id   String @id
  data Json

  @@map("legacy_product_group_metadata")
}

model CriteriaSet {
  id         String          @id @default(cuid())
  categoryId String          @unique
  isActive   Boolean         @default(true)
  version    String          @default("1") @db.VarChar(50)
  sourceHash String?         @db.VarChar(64)
  name       String?         @db.VarChar(255)
  source     String?         @db.VarChar(500)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  criteria   Criterion[]

  @@map("criteria_sets")
}

model Criterion {
  id          String         @id @default(cuid())
  setId       String
  code        String         @db.VarChar(50)
  name        String         @db.VarChar(500)
  maxScore    Int
  sectionCode String         @db.VarChar(1)
  sectionName String         @db.VarChar(255)
  order       Int
  criteriaSet CriteriaSet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  subCriteria SubCriterion[]

  @@unique([setId, code])
  @@unique([id, setId])
  @@index([setId, order])
  @@map("criteria")
}

model SubCriterion {
  id          String        @id @default(cuid())
  criterionId String
  code        String        @db.VarChar(50)
  content     String
  order       Int
  criterion   Criterion     @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  options     ScoreOption[]
  scores      Score[]

  @@unique([criterionId, code])
  @@unique([criterionId, order])
  @@unique([id, criterionId])
  @@index([criterionId])
  @@map("sub_criteria")
}

model ScoreOption {
  id             String       @id @default(cuid())
  subCriterionId String
  label          String
  points         Int
  order          Int
  subCriterion   SubCriterion @relation(fields: [subCriterionId], references: [id], onDelete: Cascade)
  scores         Score[]

  @@unique([id, subCriterionId])
  @@unique([subCriterionId, order])
  @@index([subCriterionId])
  @@map("score_options")
}

model Product {
  id                       String                   @id @default(cuid())
  codeNumber               Int                      @unique @default(autoincrement())
  createdById              String?
  createdBy                User?                    @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict)
  localityId               String?
  locality                 Locality?                @relation(fields: [localityId], references: [id], onDelete: Restrict)
  localityCodeAtSubmit     String?                  @db.VarChar(50)
  localityNameAtSubmit     String?                  @db.VarChar(255)
  provinceNameAtSubmit     String?                  @db.VarChar(255)
  completedAt              DateTime?                @db.Timestamptz(3)
  approvedAt               DateTime?                @db.Timestamptz(3)
  approvedById             String?
  approvedBy               User?                    @relation("ProductApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  returnedAt               DateTime?                @db.Timestamptz(3)
  returnedById             String?
  returnedBy               User?                    @relation("ProductReturner", fields: [returnedById], references: [id], onDelete: SetNull)
  returnReason             String?                  @db.VarChar(1000)
  requiredAgencySnapshot   Json?
  publicationState         ProductPublicationState  @default(UNPUBLISHED)
  publishedFinalScore      Float?
  publishedStarRating      Int?
  publishedAt              DateTime?                @db.Timestamptz(3)
  publishedById            String?
  publishedBy              User?                    @relation("ProductPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  statusEvents             ProductStatusEvent[]
  judgeAssignments         ProductJudgeAssignment[]
  resultHistory            ProductResultHistory[]
  registrantId             String
  categoryId               String
  name                     String                   @db.VarChar(255)
  description              String?
  formData                 Json
  registrationSnapshot     Json?
  status                   ProductStatus            @default(DRAFT)
  finalScore               Float?
  starRating               Int?
  submittedAt              DateTime?                @db.Timestamptz(3)
  createdAt                DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(3)
  registrant               User                     @relation("ProductRegistrant", fields: [registrantId], references: [id], onDelete: Restrict)
  category                 ProductCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments              Attachment[]
  evaluations              Evaluation[]

  @@index([status, categoryId, createdAt])
  @@index([status, submittedAt])
  @@index([status, completedAt])
  @@index([localityId])
  @@index([registrantId, createdAt])
  @@index([registrantId, status, updatedAt])
  @@index([formData(ops: JsonbPathOps)], type: Gin)
  @@map("products")
}

model ProductJudgeAssignment {
  id                  String          @id @default(cuid())
  productId           String
  judgeId             String
  managingAgencyId    String?
  organizationUnitId  String?
  isManual            Boolean         @default(false)
  mustSubmitToComplete Boolean        @default(false)
  isActive            Boolean         @default(true)
  assignedAt          DateTime        @default(now()) @db.Timestamptz(3)
  assignedById        String?
  removedAt           DateTime?       @db.Timestamptz(3)
  removedById         String?
  removeReason        String?         @db.VarChar(255)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  judge               User            @relation("ProductJudge", fields: [judgeId], references: [id], onDelete: Restrict)
  managingAgency      ManagingAgency? @relation(fields: [managingAgencyId], references: [id], onDelete: SetNull)
  assignedBy          User?           @relation("ProductAssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)
  removedBy           User?           @relation("ProductAssignmentRemover", fields: [removedById], references: [id], onDelete: SetNull)

  @@unique([productId, judgeId])
  @@index([productId, isActive])
  @@index([judgeId, isActive])
  @@map("product_judge_assignments")
}

model ProductResultHistory {
  id          String   @id @default(cuid())
  productId   String
  action      String   @db.VarChar(50)
  finalScore  Float?
  starRating  Int?
  isCurrent   Boolean  @default(false)
  actorId     String?
  reason      String?  @db.VarChar(255)
  snapshot    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  actor       User?    @relation("ProductResultHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@map("product_result_history")
}

model ProductStatusEvent {
  id         String         @id @default(cuid())
  productId  String
  fromStatus ProductStatus?
  toStatus   ProductStatus
  sequence   Int
  actorId    String?
  reason     String?        @db.VarChar(255)
  createdAt  DateTime       @default(now()) @db.Timestamptz(3)
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  actor      User?          @relation("StatusEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@unique([productId, sequence])
  @@index([createdAt])
  @@map("product_status_events")
}

model Attachment {
  id        String         @id @default(cuid())
  productId String
  type      AttachmentType
  fileName  String         @db.VarChar(500)
  filePath  String         @db.VarChar(1000)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@map("attachments")
}

model JudgeAssignment {
  judgeId      String
  categoryId   String
  criterionIds String[]        @default([])
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  judge        User            @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  category     ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([judgeId, categoryId])
  @@index([categoryId])
  @@map("judge_assignments")
}

model Evaluation {
  id                 String                   @id @default(cuid())
  judgeId            String
  productId          String
  status             EvaluationStatus         @default(IN_PROGRESS)
  previousStatus     EvaluationStatus?
  submittedAt        DateTime?                @db.Timestamptz(3)
  submissionSnapshot Json?
  total              Int?
  reopenedAt         DateTime?                @db.Timestamptz(3)
  reopenedById       String?
  reopenReason       String?                  @db.VarChar(255)
  excludedAt         DateTime?                @db.Timestamptz(3)
  excludedById       String?
  excludeReason      String?                  @db.VarChar(255)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  judge              User                     @relation(fields: [judgeId], references: [id], onDelete: Restrict)
  product            Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  scores             Score[]
  historyEvents      EvaluationHistoryEvent[]

  @@unique([judgeId, productId])
  @@index([productId, status])
  @@index([judgeId, status])
  @@map("evaluations")
}

model EvaluationHistoryEvent {
  id             String            @id @default(cuid())
  evaluationId   String
  action         String            @db.VarChar(50)
  fromStatus     EvaluationStatus?
  toStatus       EvaluationStatus
  actorId        String?
  reason         String?           @db.VarChar(255)
  previousTotal  Int?
  snapshot       Json?
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  evaluation     Evaluation        @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  actor          User?             @relation("EvaluationHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([evaluationId, createdAt])
  @@map("evaluation_history_events")
}

model Score {
  evaluationId   String
  subCriterionId String
  optionId       String
  note           String?      @db.VarChar(2000)
  evaluation     Evaluation   @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  subCriterion   SubCriterion @relation(fields: [subCriterionId], references: [id], onDelete: Restrict)
  option         ScoreOption  @relation(fields: [optionId, subCriterionId], references: [id, subCriterionId], onDelete: Restrict)

  @@id([evaluationId, subCriterionId])
  @@index([subCriterionId])
  @@map("scores")
}

model RegistrationUnit {
  id                  String   @id @default(cuid())
  registrantId        String
  entityName          String   @db.VarChar(255)
  representativeName  String   @db.VarChar(255)
  representativeTitle String   @db.VarChar(255)
  contactAddress      String   @db.VarChar(1000)
  provinceName        String   @db.VarChar(100)
  localityName        String   @db.VarChar(255)
  localityCode        String?  @db.VarChar(50)
  phone               String?  @db.VarChar(30)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  registrant          User     @relation("UserRegistrationUnits", fields: [registrantId], references: [id], onDelete: Cascade)

  @@index([registrantId, updatedAt])
  @@map("registration_units")
}
