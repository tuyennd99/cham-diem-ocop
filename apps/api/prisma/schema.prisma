generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REGISTRANT
  JUDGE
  ADMIN
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
}

enum ProductStatus {
  DRAFT
  SUBMITTED
  SCORING
  COMPLETED
}

enum AttachmentType {
  IMAGE
  EVIDENCE
}

enum EvaluationStatus {
  IN_PROGRESS
  SUBMITTED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique @db.VarChar(320)
  password     String            @db.VarChar(255)
  fullName     String            @db.VarChar(255)
  phone        String?           @db.VarChar(30)
  role         Role              @default(REGISTRANT)
  verified     Boolean           @default(false)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  products     Product[]
  assignments  JudgeAssignment[]
  evaluations  Evaluation[]
  otpCodes     OtpCode[]

  @@index([role])
  @@map("users")
}

model OtpCode {
  id        String     @id @default(cuid())
  email     String     @db.VarChar(320)
  code      String     @db.VarChar(255)
  purpose   OtpPurpose
  expiresAt DateTime   @db.Timestamptz(3)
  usedAt    DateTime?  @db.Timestamptz(3)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, expiresAt])
  @@index([userId])
  @@map("otp_codes")
}

model ProductCategory {
  id          String       @id @default(cuid())
  groupCode   String       @db.VarChar(50)
  groupName   String       @db.VarChar(255)
  name        String       @unique @db.VarChar(255)
  description String?
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)
  criteriaSet CriteriaSet?
  products    Product[]
  assignments JudgeAssignment[]

  @@index([groupCode, name])
  @@map("product_categories")
}

model CriteriaSet {
  id         String          @id @default(cuid())
  categoryId String          @unique
  name       String?         @db.VarChar(255)
  source     String?         @db.VarChar(500)
  createdAt  DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @db.Timestamptz(3)
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  criteria   Criterion[]

  @@map("criteria_sets")
}

model Criterion {
  id          String        @id @default(cuid())
  setId       String
  code        String        @db.VarChar(50)
  name        String        @db.VarChar(500)
  maxScore    Int
  order       Int
  criteriaSet CriteriaSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
  subCriteria SubCriterion[]

  @@unique([setId, code])
  @@unique([id, setId])
  @@index([setId, order])
  @@map("criteria")
}

model SubCriterion {
  id          String       @id @default(cuid())
  criterionId String
  content     String
  order       Int
  criterion   Criterion    @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  options     ScoreOption[]
  scores      Score[]

  @@unique([criterionId, order])
  @@unique([id, criterionId])
  @@index([criterionId])
  @@map("sub_criteria")
}

model ScoreOption {
  id             String       @id @default(cuid())
  subCriterionId String
  label          String
  points         Int
  subCriterion   SubCriterion  @relation(fields: [subCriterionId], references: [id], onDelete: Cascade)
  scores         Score[]

  @@unique([id, subCriterionId])
  @@unique([subCriterionId, points])
  @@index([subCriterionId])
  @@map("score_options")
}

model Product {
  id           String        @id @default(cuid())
  registrantId String
  categoryId   String
  name         String        @db.VarChar(255)
  description  String?
  formData     Json
  status       ProductStatus @default(DRAFT)
  finalScore   Float?
  starRating   Int?
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  registrant   User          @relation(fields: [registrantId], references: [id], onDelete: Restrict)
  category     ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  attachments  Attachment[]
  evaluations  Evaluation[]

  @@index([status, categoryId, createdAt])
  @@index([registrantId, createdAt])
  @@map("products")
}

model Attachment {
  id        String         @id @default(cuid())
  productId String
  type      AttachmentType
  fileName  String         @db.VarChar(500)
  filePath  String         @db.VarChar(1000)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, type])
  @@map("attachments")
}

model JudgeAssignment {
  judgeId      String
  categoryId   String
  criterionIds String[]     @default([])
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  judge        User         @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  category     ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([judgeId, categoryId])
  @@index([categoryId])
  @@map("judge_assignments")
}

model Evaluation {
  id        String           @id @default(cuid())
  judgeId   String
  productId String
  status    EvaluationStatus @default(IN_PROGRESS)
  total     Int?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  judge     User             @relation(fields: [judgeId], references: [id], onDelete: Restrict)
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  scores    Score[]

  @@unique([judgeId, productId])
  @@index([productId, status])
  @@map("evaluations")
}

model Score {
  evaluationId   String
  subCriterionId String
  optionId       String
  note           String?       @db.VarChar(2000)
  evaluation     Evaluation    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  subCriterion   SubCriterion  @relation(fields: [subCriterionId], references: [id], onDelete: Restrict)
  option         ScoreOption   @relation(fields: [optionId, subCriterionId], references: [id, subCriterionId], onDelete: Restrict)

  @@id([evaluationId, subCriterionId])
  @@index([subCriterionId])
  @@map("scores")
}
